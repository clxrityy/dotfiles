# git/example.gitconfig
#
# Purpose:
#   Tracked starter config for a local ~/.gitconfig.
#   Copy this into place with `make setup-git-access`, then let the setup
#   script write machine-specific identity/auth settings.

[user]
	name = Your Name
	email = 12345678+github-username@users.noreply.github.com

[core]
	editor = code

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true

[credential]
	helper = cache

[credential "https://github.com"]
	helper = !gh auth git-credential
